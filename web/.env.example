# ============================================================
# flameFIT — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/syyxfsfcnqzzhmrxfdqw/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ── OpenAI ────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# After running: npx ts-node scripts/create-vector-store.ts
OPENAI_VECTOR_STORE_ID=vs_...

# From: https://platform.openai.com/assistants
OPENAI_ASSISTANT_ID=asst_...

# ── Pinecone ──────────────────────────────────────────────────
# Get from: https://app.pinecone.io
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=flamefit-knowledge-base
